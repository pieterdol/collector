# Copy to .env and fill in what you have. Everything here is OPTIONAL for a
# first run — the app works without any API key (manual entry still works,
# and Open Library needs no key at all).

# ── App ─────────────────────────────────────────────────────────────────────
# Port the web app is served on (http://localhost:8080 by default)
APP_PORT=8080
# Secret used to sign login tokens. Set a long random string in production:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ── Database (defaults are fine for local use) ──────────────────────────────
POSTGRES_USER=collector
POSTGRES_PASSWORD=collector
POSTGRES_DB=collector

# ── Movie metadata: TMDB ────────────────────────────────────────────────────
# Get a free API key: https://www.themoviedb.org/settings/api
# (create an account, request an API key, use the "API Read Access Token"
#  or the v3 API key — this app expects the v3 key)
TMDB_API_KEY=

# ── Game metadata: IGDB (via Twitch) ────────────────────────────────────────
# IGDB uses Twitch credentials: https://dev.twitch.tv/console/apps
# Register an app (OAuth redirect URL can be http://localhost), then copy
# the Client ID and generate a Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Steam import ────────────────────────────────────────────────────────────
# Get a key: https://steamcommunity.com/dev/apikey (domain can be localhost)
STEAM_API_KEY=

# ── Music metadata: Discogs (optional upgrade) ──────────────────────────────
# Music search works with NO key at all via MusicBrainz. Set a Discogs
# personal access token to search Discogs instead: deeper pressing data
# (matrix numbers, pressing plants, per-variant covers).
# Discogs → Settings → Developers → "Generate new token".
DISCOGS_TOKEN=

# ── Reading a photographed cover (optional) ────────────────────────────────
# Discs and game boxes have no public barcode catalog. Configure a vision
# backend and the add flow gains a "Photo of cover" tab: one call reads the
# title, console and publisher off the front and they become catalog searches.
# VISION_BACKENDS is the order to try — first to answer wins, unconfigured
# ones drop out, and with none left the tab stays hidden.
VISION_BACKENDS=gemini,ollama

# Local backend: private, keyless, ~4.6s per photo.
#   ollama pull gemma3:4b
# From a container the host is host.containers.internal (podman) or
# host.docker.internal (docker). Ollama listens on 127.0.0.1 by default, which
# containers cannot reach — start it with OLLAMA_HOST=0.0.0.0:11434.
OLLAMA_URL=http://host.containers.internal:11434
# gemma3:4b reads all of title + console + publisher in one call. Bigger is
# not better here: gemma3:12b misreads stylised titles the 4b gets right.
VISION_MODEL=gemma3:4b

# Gemini backend: ~1s per photo, free tier covers this use many times over.
# NOTE: free-tier prompts may be used to improve Google's products. The paid
# tier doesn't, and costs roughly 3 cents a month at this volume. Leave empty
# to keep everything on your own machine.
GEMINI_API=
GEMINI_VISION_MODEL=gemini-flash-lite-latest
