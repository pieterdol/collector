# Copy to .env and fill in what you have. Everything here is OPTIONAL for a
# first run — the app works without any API key (manual entry still works,
# and Open Library needs no key at all).

# ── App ─────────────────────────────────────────────────────────────────────
# Port the web app is served on (http://localhost:8080 by default)
APP_PORT=8080
# Secret used to sign login tokens. Set a long random string in production:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ── Database (defaults are fine for local use) ──────────────────────────────
POSTGRES_USER=collector
POSTGRES_PASSWORD=collector
POSTGRES_DB=collector

# ── Movie metadata: TMDB ────────────────────────────────────────────────────
# Get a free API key: https://www.themoviedb.org/settings/api
# (create an account, request an API key, use the "API Read Access Token"
#  or the v3 API key — this app expects the v3 key)
TMDB_API_KEY=

# ── Game metadata: IGDB (via Twitch) ────────────────────────────────────────
# IGDB uses Twitch credentials: https://dev.twitch.tv/console/apps
# Register an app (OAuth redirect URL can be http://localhost), then copy
# the Client ID and generate a Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Steam import ────────────────────────────────────────────────────────────
# Get a key: https://steamcommunity.com/dev/apikey (domain can be localhost)
STEAM_API_KEY=

# ── Music metadata: Discogs (optional upgrade) ──────────────────────────────
# Music search works with NO key at all via MusicBrainz. Set a Discogs
# personal access token to search Discogs instead: deeper pressing data
# (matrix numbers, pressing plants, per-variant covers).
# Discogs → Settings → Developers → "Generate new token".
DISCOGS_TOKEN=
